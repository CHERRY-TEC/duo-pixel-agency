{
  "name": "duo-pixel-agency",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Duo Pixel Agency — book a custom website design from one of two designers.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build && vite build --config vite.site.config.ts && vite build --config vite.portal.config.ts",
    "build:site": "tsc --noEmit -p tsconfig.json && vite build --config vite.site.config.ts",
    "build:portal": "tsc --noEmit -p tsconfig.json && vite build --config vite.portal.config.ts",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@supabase/supabase-js": "^2.47.10",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.474.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^6.28.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^5.4.14"
  }
}
