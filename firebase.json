{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/login", "destination": "/portal.html" },
      { "source": "/signup", "destination": "/portal.html" },
      { "source": "/track", "destination": "/portal.html" },
      { "source": "/track/**", "destination": "/portal.html" },
      { "source": "/account/**", "destination": "/portal.html" },
      { "source": "/dashboard", "destination": "/portal.html" },
      { "source": "/dashboard/**", "destination": "/portal.html" },
      { "source": "/admin", "destination": "/portal.html" },
      { "source": "/admin/**", "destination": "/portal.html" },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "/favicon.png",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      }
    ]
  }
}
