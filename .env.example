# ---------------------------------------------------------------------------
# Duo Pixel Agency — environment variables
# Copy this file to `.env` (local) and to your host's env settings (Vercel /
# Firebase Hosting) for production. Everything works in "local demo mode"
# when the Supabase values below are empty.
# ---------------------------------------------------------------------------

# --- Supabase (Auth + Postgres + Storage + Realtime) -----------------------
# Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Where the two apps live ----------------------------------------------
# The public website (index.html) and the portal (portal.html) are served from
# ONE origin by default, which is what local dev, `npm run preview` and a
# single-domain deploy all use. Leave both empty in that case.
#
# Only fill them in when you deploy the two apps on separate domains
# (`npm run build:site` -> dist/site, `npm run build:portal` -> dist/portal):
#   VITE_SITE_URL=https://duopixel.agency
#   VITE_PORTAL_URL=https://app.duopixel.agency
# Each one is the OTHER app's origin.
VITE_SITE_URL=
VITE_PORTAL_URL=

# --- Supabase Edge Function that sends the booking confirmation email ------
# Deploy with: supabase functions deploy send-booking-email
VITE_EMAIL_FUNCTION_URL=

# --- Agency contact details (shown in the footer / contact page) -----------
VITE_WHATSAPP_NUMBER=919876543210
VITE_CONTACT_EMAIL=duopixelagency@gmail.com

# --- Designer accounts used in local demo mode (no Supabase required) ------
# Demo login details are printed on the /login screen when Supabase is unset.
